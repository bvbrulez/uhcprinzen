#!/bin/sh

set -eu

# 1. Syntax Check for JS/MJS files
# Use git diff to find staged JS/MJS files
STAGED_JS=$(git diff --cached --name-only | grep -E '\.(js|mjs)$' || true)

if [ -n "$STAGED_JS" ]; then
  echo "Prüfe JavaScript-Syntax..."
  for file in $STAGED_JS; do
    if [ -f "$file" ]; then
      node --check "$file" || { echo "Syntax-Fehler in $file"; exit 1; }
    fi
  done
fi

# 2. Changelog update
CHANGELOG="CHANGELOG.md"
DATE_TODAY=$(date +%Y-%m-%d)
ALL_STAGED=$(git diff --cached --name-status -- . ':(exclude)CHANGELOG.md')

if [ -z "$ALL_STAGED" ]; then
  exit 0
fi

if [ ! -f "$CHANGELOG" ]; then
  {
    printf '%s\n\n' '# Changelog'
    printf '%s\n\n' 'Alle Änderungen sind chronologisch nach Commit aufgeführt.'
  } > "$CHANGELOG"
fi

TEMP_FILE=$(mktemp)
FILE_LIST=$(mktemp)
trap 'rm -f "$TEMP_FILE" "$FILE_LIST"' EXIT

printf '%s\n' "$ALL_STAGED" | sed 's/	/ – /; s/^/- `/; s/$/`/' > "$FILE_LIST"

awk -v date="$DATE_TODAY" -v file_list="$FILE_LIST" '
  function print_entry() {
    print "### Änderungen aus diesem Commit"
    print ""
    print "- Aktualisiert am " date ":"
    while ((getline line < file_list) > 0) print line
    close(file_list)
    print ""
  }
  $0 == "## " date {
    print
    print_entry()
    inserted = 1
    next
  }
  {
    print
  }
  END {
    if (!inserted) {
      print ""
      print "## " date
      print ""
      print_entry()
    }
  }
' "$CHANGELOG" > "$TEMP_FILE"

mv "$TEMP_FILE" "$CHANGELOG"
git add "$CHANGELOG"

printf '%s\n' "CHANGELOG.md wurde für $DATE_TODAY aktualisiert."
